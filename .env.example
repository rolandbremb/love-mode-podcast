# Public Sanity project details used by the site and embedded Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: only needed for authenticated server-side requests
SANITY_API_TOKEN=

# Website forms (Be a Guest + Collaborate)
# Sanity token with Editor rights, so submissions are saved to the Studio inbox
SANITY_WRITE_TOKEN=
# Resend API key (resend.com) for emailing each submission
RESEND_API_KEY=
# Where submissions are emailed (comma-separate several addresses)
CONTACT_TO_EMAIL=
# Optional: sender once your domain is verified in Resend, e.g. Love Mode <web@lovemodepod.com>
CONTACT_FROM_EMAIL=

# Paid email ("Cuéntamelo por email"): Stripe secret key (sk_test_… while testing)
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook pointing at /api/stripe/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=

# The live website address, used for share previews. Optional on Vercel,
# where it falls back to the project's production domain.
NEXT_PUBLIC_SITE_URL=https://lovemodepod.com

# Dashboard (/dashboard): the password Andrea signs in with
DASHBOARD_PASSWORD=
# Cal.com API key (Settings → Developer → API keys), for calls on the dashboard
CAL_API_KEY=
# Stripe restricted key that can read Charges, for revenue on the dashboard
STRIPE_REPORTING_KEY=
# Buy Me a Coffee webhook signing secret (Integrations → your webhook), optional:
# without it, coffee income can be entered by hand on the dashboard
BMC_WEBHOOK_SECRET=
