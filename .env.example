# Public Sanity project details used by the site and embedded Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: only needed for authenticated server-side requests
SANITY_API_TOKEN=

# Website forms (Be a Guest + Collaborate)
# Sanity token with Editor rights, so submissions are saved to the Studio inbox
SANITY_WRITE_TOKEN=
# Resend API key (resend.com) for emailing each submission
RESEND_API_KEY=
# Where submissions are emailed (comma-separate several addresses)
CONTACT_TO_EMAIL=
# Optional: sender once your domain is verified in Resend, e.g. Love Mode <web@lovemodepod.com>
CONTACT_FROM_EMAIL=

# The live website address, used for share previews. Optional on Vercel,
# where it falls back to the project's production domain.
NEXT_PUBLIC_SITE_URL=https://lovemodepod.com
