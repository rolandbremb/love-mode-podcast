{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "love-mode-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "love-mode-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "love-mode-review",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3002"],
      "env": { "SHOW_UPCOMING_SECTIONS": "true" },
      "port": 3002
    }
  ]
}
